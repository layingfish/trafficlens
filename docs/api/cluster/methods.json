{"methods": {"kmeans": {"label": "K-Means", "params": [{"name": "k", "label": "簇数 k", "type": "select", "default": "5", "min": 2, "max": 8, "options": ["2", "3", "4", "5", "6", "7", "8"]}, {"name": "n_init", "label": "初始化次数", "type": "select", "default": "10", "min": 1, "max": 50, "options": ["10"]}]}, "agglomerative": {"label": "层次聚类 Agglomerative", "params": [{"name": "k", "label": "簇数 k", "type": "select", "default": "5", "min": 2, "max": 8, "options": ["2", "3", "4", "5", "6", "7", "8"]}, {"name": "linkage", "label": "连接方式", "type": "select", "default": "ward", "options": ["ward", "complete", "average", "single"]}]}, "gmm": {"label": "高斯混合 GMM", "params": [{"name": "k", "label": "成分数 k", "type": "select", "default": "5", "min": 2, "max": 8, "options": ["2", "3", "4", "5", "6", "7", "8"]}, {"name": "covariance_type", "label": "协方差类型", "type": "select", "default": "diag", "options": ["full", "tied", "diag", "spherical"]}]}, "spectral": {"label": "谱聚类 Spectral", "params": [{"name": "k", "label": "簇数 k", "type": "select", "default": "5", "min": 2, "max": 8, "options": ["2", "3", "4", "5", "6", "7", "8"]}, {"name": "n_neighbors", "label": "近邻数", "type": "select", "default": "10", "min": 3, "max": 50, "options": ["5", "10", "20"]}]}, "dbscan": {"label": "DBSCAN", "params": [{"name": "eps", "label": "邻域半径 eps", "type": "select", "default": "0.35", "min": 0.05, "max": 50, "step": 0.05, "options": ["0.35", "0.5", "1", "2", "4", "8"]}, {"name": "min_samples", "label": "最小样本数", "type": "select", "default": "3", "min": 2, "max": 30, "options": ["3", "5"]}]}, "hdbscan": {"label": "HDBSCAN", "params": [{"name": "min_cluster_size", "label": "最小簇大小", "type": "select", "default": "5", "min": 2, "max": 50, "options": ["3", "5", "8", "12"]}]}}, "features": {"wd_we": "工作日+休息日 日内曲线（48 维）", "daily": "平均日内曲线（24 维）", "weekly": "平均周内曲线（168 维）", "stats": "统计特征（均值/变异/峰时/昼夜比/周末比）"}, "norms": {"shape": "形状归一（除以区域均值，只看模式）", "zscore": "Z-score（每区域标准化）", "log": "log1p 原值（保留量级）"}}